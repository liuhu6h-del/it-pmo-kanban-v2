{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__playwright__browser_click",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/chatbot-voice.sh"
          }
        ]
      },
      {
        "matcher": "mcp__playwright__browser_navigate",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/briefing-reminder.sh"
          }
        ]
      }
    ]
  }
}
